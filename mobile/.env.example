# Copy to .env and fill in.

# Where the Kamsar o Bar backend API is (must end with /api).
#  - Your deployed site:                 https://kamsarobar.in/api
#  - A computer on your Wi-Fi (testing): http://192.168.1.5:8080/api   (also set ALLOW_HTTP=true)
#  - Android emulator on this computer:  http://10.0.2.2:8080/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api

# Web address of the website, used for the "Open admin panel" link.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Only for testing against plain http:// (never in production builds).
ALLOW_HTTP=true

# From `npx eas-cli@latest init` - needed for push notifications.
EAS_PROJECT_ID=

# Path to google-services.json from your Firebase project - needed for push notifications on Android.
GOOGLE_SERVICES_JSON=./google-services.json
